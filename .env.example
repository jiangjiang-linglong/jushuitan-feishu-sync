# ==================== 聚水潭配置 ====================
# 必填，在聚水潭开放平台获取
JUSHUITAN_APP_KEY=
JUSHUITAN_APP_SECRET=
JUSHUITAN_ACCESS_TOKEN=
JUSHUITAN_API_BASE=https://openapi.jushuitan.com

# 默认店铺ID（数字），同步时未匹配到店铺映射时使用
JUSHUITAN_SHOP_ID=

# 店铺ID映射（JSON）：key 为表格"店铺"字段的选项ID，value 为聚水潭店铺ID
# 例：SHOP_ID_MAP={"optSXRrqJ7":13984762}
SHOP_ID_MAP={}

# 固定买家账号（聚水潭建单的 shop_buyer_id）
BUYER_NICK=

# ==================== 飞书配置 ====================
# 必填，在飞书开放平台创建应用后获取
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=
# 多维表格 App Token（URL 中 /base/ 后面的部分）
FEISHU_APP_TOKEN=
# 多维表格数据表 ID
FEISHU_TABLE_ID=tblXXXX

# ==================== 可选配置 ====================
# HTTP 服务端口，默认 3003
# PORT=3003
# 自动同步间隔（毫秒），默认 60000
# SYNC_INTERVAL_MS=60000
# 补全内部单号/快递单号的间隔（毫秒），默认 30 分钟
# BACKFILL_INTERVAL_MS=1800000
# 打印 DEBUG 日志（可能包含订单详情，默认关闭）
# DEBUG=false
